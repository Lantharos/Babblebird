{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "babblebird",
  "account_id": "2e3bfcbc9512a7ab1ea3a9cb9a474b30",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "babblebird.dev", "custom_domain": true }],
  "assets": { "binding": "ASSETS", "directory": "../web/.svelte-kit/cloudflare" },
  "alias": { "@babblebird/web/worker": "../web/.svelte-kit/cloudflare/_worker.js" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "vars": {
    "PUBLIC_URL": "https://babblebird.dev",
    "NOTIFY_FROM": "no-reply@babblebird.dev",
    "GITHUB_API": "https://api.github.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babblebird",
      "database_id": "e0edca1e-a134-4137-80bb-882342a05945",
      "migrations_dir": "migrations/core"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STRINGS", "class_name": "ProjectStrings" },
      { "name": "MEMORY", "class_name": "Memory" }
    ]
  },
  "exports": {
    "ProjectStrings": { "type": "durable-object", "storage": "sqlite" },
    "Memory": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "babblebird" }],
  "queues": {
    "producers": [
      { "binding": "SYNC", "queue": "babblebird-sync" },
      { "binding": "DELIVER", "queue": "babblebird-deliver" }
    ],
    "consumers": [
      { "queue": "babblebird-sync", "max_batch_size": 4, "max_batch_timeout": 1, "max_retries": 5 },
      { "queue": "babblebird-deliver", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5 }
    ]
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
    { "name": "MAIL_LIMIT", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["*/10 * * * *"] }
}
