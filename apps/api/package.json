{
  "name": "@babblebird/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "deploy": "pult build && wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply STRINGS_0 --remote && wrangler deploy",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply STRINGS_0 --local",
    "check": "wrangler types && tsc -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@babblebird/fluent": "workspace:*",
    "@babblebird/protocol": "workspace:*",
    "@better-auth/passkey": "1.7.18",
    "@lantharos/pult": "0.13.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jose": "6.2.15",
    "postal-mime": "4.2.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.158.0"
  }
}
