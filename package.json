{
  "name": "babblebird",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @babblebird/api --filter @babblebird/web dev",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "7.0.2"
  }
}
